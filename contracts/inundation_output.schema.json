{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "inundation_output.schema.json",
  "title": "InundationOutput",
  "description": "An inundation prediction tile.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tile_id",
    "timestamp",
    "flood_probability",
    "depth_band",
    "confidence"
  ],
  "properties": {
    "tile_id": {
      "type": "string",
      "description": "Identifier of the prediction tile."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Valid time of the inundation prediction."
    },
    "flood_probability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Predicted flood probability in the range 0 to 1."
    },
    "depth_band": {
      "type": "string",
      "description": "Predicted inundation depth band."
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Prediction confidence in the range 0 to 1."
    }
  }
}
