{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "raster.schema.json",
  "title": "Raster",
  "description": "Geospatial raster metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "variable",
    "valid_time",
    "crs",
    "resolution_m",
    "bbox",
    "nodata",
    "quality_score",
    "file_uri"
  ],
  "properties": {
    "source": {
      "type": "string",
      "description": "Origin of the raster."
    },
    "variable": {
      "type": "string",
      "description": "Name of the raster variable."
    },
    "valid_time": {
      "type": "string",
      "format": "date-time",
      "description": "Valid time of the raster."
    },
    "crs": {
      "type": "string",
      "description": "Coordinate reference system."
    },
    "resolution_m": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Raster resolution in meters."
    },
    "bbox": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number"
      },
      "description": "Bounding box coordinates for the raster extent."
    },
    "nodata": {
      "type": "number",
      "description": "Sentinel value used for missing cells."
    },
    "quality_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Quality score in the range 0 to 1."
    },
    "file_uri": {
      "type": "string",
      "description": "Location of the raster file."
    }
  }
}
